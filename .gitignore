# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# локальная база и рантайм-артефакты
*.db
*.db-journal
.run/
# но базу с контентом коммитим для прод-сидинга
!/dev.db

# артефакты сборки видео (не отдаются сайтом)
/public/uploads/v2/

# Приватные файлы кабинета агента (вне git)
agent-files/

# Локальные бэкапы БД
backups/

# Временные мастера видео
.video-tmp/
