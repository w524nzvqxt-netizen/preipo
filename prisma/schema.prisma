// Схема базы данных витрины pre-IPO проектов

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Проект (pre-IPO компания) — то, что видит посетитель на витрине
model Project {
  id          String  @id @default(cuid())
  name        String // Название компании
  sector      String? // Отрасль (напр. "Финтех")
  stage       String? // Стадия (напр. "Series C")
  description String? // Краткое содержание (о компании)
  logoUrl     String? // Ссылка на логотип

  // Структурированный контент (по пункту на строку)
  salesPoints String? // Основные сейлз-поинты
  pros        String? // Плюсы компании
  risks       String? // Риски компании

  pricePerShare Float? // Цена за акцию/долю
  currency      String  @default("USD") // Валюта цены
  volume        Float? // Доступный объём (в деньгах)
  minTicket     Float? // Минимальный чек для входа (не отображается)
  valuation     Float? // Оценка компании (оценка входа)

  expectedExit   String? // Прогноз выхода на биржу (напр. "H2 2029")
  expectedReturn Float? // Потенциальная доходность, % (напр. 51)

  videoScript String? // JSON-сценарий видео о проекте (сцены: caption+narration)

  financialAnalysis String? // JSON AI-оценки фин. отчётности и плана компании
  scenarios         String? // JSON ожидаемых результатов на $100k (лучший/средний/худший)

  // Видео с диктором HeyGen
  videoJobId  String? // ID задачи генерации в HeyGen
  videoStatus String? // processing | completed | failed
  videoUrl    String? // Путь к скачанному mp4 в /public (или ошибка)

  isActive Boolean @default(true) // Показывать ли на витрине
  isHot    Boolean @default(false) // Метка "горячий" проект

  // Статус сделки: open — открытый раунд (можно войти), closed — реализованная сделка (трек-рекорд)
  dealStatus String @default("open")
  exitValuation Float? // Ожидаемая оценка на выходе (для трек-рекорда)
  cocMultiple   Float? // Net CoC, мультипликатор на капитал (напр. 5.6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads     Lead[]
  documents ProjectDocument[]
}

// Документ проекта (PDF, презентация) — для скачивания со страницы проекта
model ProjectDocument {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String // Название документа (напр. "Презентация Anthropic")
  kind      String   @default("doc") // doc | financial | presentation
  fileUrl   String // Путь к файлу в /public (напр. "/uploads/abc.pdf")
  fileName  String // Исходное имя файла
  sizeBytes Int // Размер для отображения
  createdAt DateTime @default(now())
}

// Котировка для бегущей строки (управляется из админки)
model Quote {
  id        String   @id @default(cuid())
  name      String // Компания
  valuation String // Оценка, напр. "$350B"
  change    String   @default("") // Изменение, напр. "+4,2%"
  up        Boolean  @default(true) // Рост (▲) или снижение (▼)
  order     Int      @default(0) // Порядок в строке
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Компания, уже вышедшая на биржу (IPO) — для раздела «трек-рекорд рынка»
// и калькулятора «что если бы вошли на раунде X».
model PublicCompany {
  id                  String   @id @default(cuid())
  name                String
  ticker              String
  sector              String?
  ipoDate             String? // напр. "2024-03"
  ipoPriceUSD         Float? // цена размещения
  ipoValuationUSD     Float? // оценка на IPO
  currentPriceUSD     Float? // цена акции сейчас
  currentMarketCapUSD Float? // капитализация сейчас
  asOf                String? // дата актуальности (напр. "2026-06")
  rounds              String? // JSON истории раундов: [{round,year,valuationUSD,note}]
  order               Int      @default(0)
  createdAt           DateTime @default(now())
}

// Новость по теме pre-IPO (генерирует ИИ-агент + правит оператор).
// summary — ОРИГИНАЛЬНЫЙ краткий пересказ (не копия статьи), со ссылкой на источник.
model NewsItem {
  id          String   @id @default(cuid())
  title       String
  summary     String // оригинальный краткий пересказ (2–4 предложения)
  category    String? // напр. "IPO", "Раунд", "Оценка", "Рынок"
  sourceName  String? // напр. "Bloomberg", "Reuters"
  sourceUrl   String?
  isHot       Boolean  @default(true)
  isActive    Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// Заявка от посетителя — лид, с которым связывается оператор
model Lead {
  id        String   @id @default(cuid())
  name      String // Имя посетителя
  contact   String // Телефон / email / @username
  message   String? // Комментарий
  projectId String? // По какому проекту заявка (необязательно)
  project   Project? @relation(fields: [projectId], references: [id])
  status    String   @default("new") // new | in_progress | done
  createdAt DateTime @default(now())
}

// === Личный кабинет агента (закрытый раздел /agent) ===

// Агент-продавец pre-IPO. Логин + scrypt-хэш пароля. isActive — мгновенный отзыв доступа.
model Agent {
  id           String           @id @default(cuid())
  username     String           @unique // логин (email/ник)
  name         String // Отображаемое имя
  passwordHash String // формат scrypt$salt$hash
  telegramId   String?          @unique // привязанный Telegram-аккаунт (для бота)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  clients      Client[]
  sales        Sale[]
  documents    ClientDocument[]
}

// Одноразовый код входа на сайт через Telegram-бота.
// Сайт создаёт код, бот подтверждает (ставит agentId), сайт логинит и удаляет код.
model LoginCode {
  code      String   @id
  agentId   String? // заполняется ботом при подтверждении
  createdAt DateTime @default(now())
}

// Клиент агента
model Client {
  id        String           @id @default(cuid())
  agentId   String
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name      String
  contact   String? // телефон/email/@tg
  notes     String?
  createdAt DateTime         @default(now())
  sales     Sale[]
  documents ClientDocument[]

  @@index([agentId])
}

// Продажа pre-IPO клиенту: что, сколько, комиссия
model Sale {
  id             String   @id @default(cuid())
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId      String? // id проекта из витрины (без жёсткой связи)
  companyName    String // название компании (фиксируем на момент сделки)
  round          String? // раунд входа (Seed / Series A-F / Pre-IPO / Secondary)
  expMultiple    Float? // ожидаемый мультипликатор на выходе (×), для прогноза прибыли
  yearsToExit    Float? // лет до IPO + окончания лок-апа (для рентабельности агента)
  amount         Float // сумма инвестиции клиента
  units          Float? // кол-во долей/акций
  pricePerUnit   Float?
  currency       String   @default("USD")
  entryFee       Float    @default(0) // комиссия за вход (5% от суммы входа)
  commission     Float    @default(0) // доля партнёра в success fee (¼ от SF)
  sf             Float    @default(0) // success fee (20% от прибыли клиента)
  commissionPaid Boolean  @default(false) // выплачен ли заработок партнёру
  status         String   @default("closed") // closed | pending
  soldAt         DateTime @default(now())
  note           String?

  @@index([agentId])
  @@index([clientId])
}

// Документ/видео по клиенту. Файл лежит ВНЕ /public, отдаётся через защищённый роут.
model ClientDocument {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  kind      String   @default("doc") // doc | video | contract
  filePath  String // путь в приватной папке agent-files/
  fileName  String
  mimeType  String   @default("application/octet-stream")
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([clientId])
}

// База pre-IPO AI-компаний (информационный раздел «База», разбор бизнеса/планов).
// Не сделка (без цен входа) — аналитический справочник.
model KbCompany {
  id             String   @id @default(cuid())
  name           String
  segment        String? // напр. "Foundation & LLM", "Physical AI & Robotics"
  website        String? // домен для логотипа
  logoUrl        String?
  founded        String? // год основания
  valuationUSD   Float? // последняя оценка (для сортировки)
  valuationLabel String? // напр. "$965 млрд"
  lastRound      String? // напр. "Series H · $13 млрд · май 2026"
  nextRound      String? // намерения о новом раунде/IPO: "Готовит IPO H2 2026" / "Раунд ~$74 млрд в процессе"
  lastNews       String? // последняя заметная новость (фраза + месяц)
  lastNewsUrl    String? // ссылка на источник новости
  rounds         String? // JSON истории раундов для графика: [{round,date:"YYYY-MM",valuationUSD}]
  oneLiner       String? // суть в одном предложении
  business       String? // чем занимается / как зарабатывает
  plans          String? // что дальше / перспектива IPO
  analysis       String? // инвест-разбор (сильные стороны + риски)
  sourceName     String?
  sourceUrl      String?
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
